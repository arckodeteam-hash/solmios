{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-375",
    "test:e2e:headed": "E2E_SLOWMO=400 playwright test --project=chromium --headed --workers=1",
    "test:e2e:ui": "playwright test --project=chromium --ui"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/resource": "^6.1.21",
    "@fullcalendar/resource-timeline": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@tailwindcss/vite": "^4.3.1",
    "@vueup/vue-quill": "^1.5.5",
    "html2canvas": "^1.4.1",
    "libphonenumber-js": "^1.13.9",
    "pinia": "^3.0.4",
    "qrcode.vue": "^3.10.0",
    "simple-icons": "^16.25.0",
    "tailwindcss": "^4.3.1",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.34",
    "vue-color-kit": "^1.0.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/google.maps": "^3.65.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.10.6",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.22",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.8"
  }
}
