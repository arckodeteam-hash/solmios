#!/usr/bin/env bash
# lk — CLI del LoopKit. Ciclo: PLAN → BUILD → VERIFY → SHIP
# Todo lo que afirma el agente queda anclado a un hash del diff. Si el código
# cambia después de verificar, la evidencia caduca sola y el gate vuelve a bloquear.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
LK="$ROOT/.loopkit"; ST="$LK/state"
ACTOR="${LOOPKIT_ACTOR:-main}"
# LOOPKIT_ENFORCE=0 → modo observación: el gate evalúa y reporta igual, pero los
# bloqueadores (Stop hook, pre-push, plugin) sólo avisan. Sirve para estrenar el kit
# en un repo real sin riesgo de trabar el trabajo. Nunca se finge la protección:
# `lk status` y `lk brief` dicen en qué modo están.
[ -f "$LK/commands.env" ] && . "$LK/commands.env" 2>/dev/null
ENFORCE="${LOOPKIT_ENFORCE:-1}"
# Guard: si ROOT quedara vacío, "$ST/audit" sería "/state/audit" y un rm -rf
# apuntaría fuera del proyecto. Preferible abortar que borrar algo ajeno.
case "$ROOT" in
  ""|"/") echo "lk: no se pudo determinar la raíz del proyecto" >&2; exit 2 ;;
esac
mkdir -p "$ST" 2>/dev/null

j() { python3 -c "
import json,sys
try: d=json.load(open('$1'))
except Exception: d={}
print(d.get('$2','$3'))
" 2>/dev/null; }

set_task() { # set_task <campo> <valor>
  python3 - "$ST/task.json" "$1" "$2" <<'PY'
import json,sys,os
p,k,v=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(p)) if os.path.exists(p) else {}
d[k]=v
json.dump(d,open(p,'w'),indent=2)
PY
}

# git nunca clona .git/hooks: quien clone el repo se queda sin la red del pre-push.
# Se repara sola en cada uso, sin tocar core.hooksPath (rompería husky u otros).
ensure_git_hook() {
  [ -d "$ROOT/.git" ] || return 0
  local src="$LK/adapters/git/pre-push" dst="$ROOT/.git/hooks/pre-push"
  [ -f "$src" ] || return 0
  if [ ! -f "$dst" ]; then
    mkdir -p "$ROOT/.git/hooks" && cp "$src" "$dst" && chmod +x "$dst"
    echo "lk: reinstalé .git/hooks/pre-push (no viaja con git clone)" >&2
  elif ! grep -q LOOPKIT "$dst" 2>/dev/null; then
    echo "lk: ya hay un .git/hooks/pre-push ajeno — el gate NO corre en push." >&2
    echo "    Agregale esta línea:  bash .loopkit/adapters/git/pre-push \"\$@\" || exit 1" >&2
  fi
}

case "${1:-help}" in

init)
  mkdir -p "$ST/evidence"
  grep -qs '^\.loopkit/state/' "$ROOT/.gitignore" 2>/dev/null || echo '.loopkit/state/' >> "$ROOT/.gitignore"
  echo "LoopKit iniciado en $LK"
  echo "  → completá .loopkit/commands.env con los comandos reales del proyecto"
  ;;

start)
  [ -z "${2:-}" ] && { echo "uso: lk start <id> [título]"; exit 2; }
  # El estado es de UNA tarea: .loopkit/state/ no está namespaceado por tarea.
  # Abrir otra encima descartaba la anterior en silencio.
  PREV_ID="$(j "$ST/task.json" id '')"; PREV_PH="$(j "$ST/task.json" phase '')"
  if [ -n "$PREV_ID" ] && [ "$PREV_ID" != "$2" ]; then
    case "$PREV_PH" in
      BUILD|VERIFY)
        if [ "${LOOPKIT_FORCE:-0}" != "1" ]; then
          echo "lk: la tarea '$PREV_ID' está en $PREV_PH y su verificación se perdería." >&2
          echo "    Cerrala (lk ship) o repetí con LOOPKIT_FORCE=1 para descartarla." >&2
          exit 2
        fi
        echo "lk: descarto la tarea '$PREV_ID' ($PREV_PH) por LOOPKIT_FORCE=1" >&2 ;;
    esac
  fi
  rm -f "$ST/measured.json" "$ST/scorecard.json"
  rm -rf "$ST/audit"
  # La base es el estado del árbol AL ABRIR la tarea, no HEAD. Si el repo ya venía
  # sucio, anclar a HEAD metía los cambios previos dentro del diff de esta tarea:
  # los auditores revisaban código ajeno y D10 (alcance) penalizaba de más.
  # `git stash create` produce un commit con el árbol actual SIN tocar el working tree.
  BASE="$(git stash create 2>/dev/null || true)"
  if [ -n "$BASE" ]; then
    git update-ref "refs/loopkit/base-$2" "$BASE" 2>/dev/null || true   # que el GC no lo borre
    echo "lk: el repo tenía cambios sin commitear; la tarea se ancla al estado actual" >&2
  else
    BASE="$(git rev-parse HEAD 2>/dev/null || echo '')"
  fi
  printf '{\n  "id": "%s",\n  "title": "%s",\n  "phase": "PLAN",\n  "builder": "%s",\n  "base": "%s",\n  "started": "%s"\n}\n' \
    "$2" "${3:-}" "$ACTOR" "$BASE" "$(date -Iseconds)" > "$ST/task.json"
  rm -f "$ST/findings.jsonl"
  ensure_git_hook
  echo "tarea $2 → PLAN (builder: $ACTOR)"
  ;;

build)   # lo llama el hook al primer Edit/Write. Idempotente y silencioso.
  [ -f "$ST/task.json" ] || printf '{"id":"adhoc","title":"","phase":"PLAN","builder":"%s"}\n' "$ACTOR" > "$ST/task.json"
  set_task phase BUILD          # cualquier fase vuelve a BUILD: se tocó código
  # el código cambió → TODA la verificación anterior caduca, incluidos los carriles
  # de auditoría. Dejarlos vivos hacía que `card merge` fallara culpando a una
  # "auditoría concurrente" que nunca ocurrió.
  rm -f "$ST/scorecard.json"
  rm -rf "$ST/audit"
  ensure_git_hook
  ;;

verify)
  set_task phase VERIFY
  bash "$LK/core/verify.sh" "${2:-HEAD}"
  ;;

gate)
  ensure_git_hook
  LOOPKIT_STATE="$ST" python3 "$LK/core/gate.py"
  ;;

subagent-seen)   # registra que corrió un subagente. Lo llaman los adaptadores.
  H="$(python3 "$LK/core/gate.py" --hash 2>/dev/null)"
  printf '{"hash":"%s","payload":{"source":"%s","tool":"%s"}}\n' \
    "$H" "${2:-adapter}" "${3:-}" >> "$ST/subagents.jsonl"
  ;;

brief)   # lo único que el orquestador necesita leer. Nunca más de 5 líneas.
  ensure_git_hook
  printf 'fase=%s tarea=%s modo=%s\n' "$(j "$ST/task.json" phase -)" "$(j "$ST/task.json" id -)" \
    "$([ "$ENFORCE" = "0" ] && echo observacion || echo bloqueo)"
  LOOPKIT_STATE="$ST" python3 "$LK/core/gate.py" --brief
  ;;

selftest)
  if [ -x "$LK/test/smoke.sh" ]; then bash "$LK/test/smoke.sh"
  else echo "no está .loopkit/test/smoke.sh — reinstalá el kit" >&2; exit 2; fi
  ;;

card)
  shift
  LOOPKIT_STATE="$ST" python3 "$LK/core/card.py" "$@"
  ;;

ship)
  if LOOPKIT_STATE="$ST" python3 "$LK/core/gate.py"; then
    set_task phase SHIP; echo "tarea → SHIP"
  else
    echo; echo "no se puede cerrar: el gate bloqueó (arriba está el motivo exacto)"; exit 1
  fi
  ;;

status)
  echo "tarea    : $(j "$ST/task.json" id -) — $(j "$ST/task.json" title '')"
  echo "fase     : $(j "$ST/task.json" phase -)"
  echo "builder  : $(j "$ST/task.json" builder -)"
  echo "medición : $([ -f "$ST/measured.json" ] && echo "sí (diff $(j "$ST/measured.json" diff_hash ?))" || echo "no")"
  echo "scorecard: $([ -f "$ST/scorecard.json" ] && echo "sí (reviewer: $(j "$ST/scorecard.json" reviewer ?), $(j "$ST/scorecard.json" verdict ?))" || echo "no")"
  echo "diff hoy : $(python3 "$LK/core/gate.py" --hash)"
  echo "modo     : $([ "$ENFORCE" = "0" ] && echo 'OBSERVACIÓN — el gate reporta pero NO bloquea' || echo 'bloqueo activo')"
  echo "auditor  : $([ -s "$ST/subagents.jsonl" ] && echo "$(wc -l < "$ST/subagents.jsonl") registro(s) de subagente" || echo "sin registros — el gate va a bloquear")"
  ;;

template)   # JSON que el REVIEWER debe llenar y guardar en state/scorecard.json
  cat "$LK/core/scorecard.template.json"
  ;;

*)
  cat <<'H'
lk — LoopKit

  lk init                     preparar el repo
  lk start <id> [título]      abrir tarea (fase PLAN)
  lk build                    marcar que se tocó código (lo hace el hook)
  lk verify [base]            ejecutar gates y medir → measured.json
  lk gate                     ¿se puede cerrar? recomputa el score y valida
  lk brief                    veredicto en <=5 líneas (para el orquestador)
  lk selftest                 correr la suite del kit sobre esta instalación
  lk ship                     cerrar si el gate pasa
  lk status                   estado actual
  lk subagent-seen <src> <t>  registrar que corrió un subagente (lo usan los adaptadores)
  lk card <sub>               llenar el scorecard con comandos (no editar JSON):
        card new · card reviewer <n> · card dim D5 85 "app.js:12 motivo"
        card find SEC-1 D6 BLOCKER CONFIRMED app.js:2 "eval sobre input"
        card fixed SEC-1 "qué se cambió" · card verdict READY · card show
  lk template                 plantilla cruda de scorecard.json (rara vez hace falta)

Ciclo: PLAN → BUILD → VERIFY → SHIP
El reviewer NO puede ser el builder. El gate lo verifica.
H
  ;;
esac
