# Comandos REALES de Manager Hotel (SOLMI OS). Verificados contra los package.json
# de backend/ y frontend/ el día de la instalación.
# Cada gate corre en su propia subshell desde la raíz: el `cd` no contamina al siguiente.

# 0 = OBSERVACIÓN: el gate evalúa y reporta, pero no bloquea nada. Empezá acá.
# 1 = BLOQUEO: el fin de turno, el commit y el push se frenan si el gate no pasa.
LOOPKIT_ENFORCE=0

BUILD="cd frontend && bun run build"
TYPECHECK="cd backend && bun run typecheck && cd ../frontend && bun run typecheck"
# backend `lint` es un placeholder (`echo "No linter configured"`, exit 0): reportaba
# PASS sin verificar nada. Vacío = N/V honesto. Cuando agregues eslint al backend,
# poné acá: LINT="cd backend && bun run lint"
LINT=""
# Encadenado con &&: si backend falla, frontend no llega a correr. Es a propósito
# (un gate falla rápido), pero significa que mientras backend esté en rojo no vas a
# ver el estado del frontend.
TEST="cd backend && bun test && cd ../frontend && bun run test"

# arckode analyze: 0 violaciones o es FAIL automático
EXTRA="cd backend && bun run analyze"
EXTRA_NAME="arckode"

LOOPKIT_TIMEOUT=600
